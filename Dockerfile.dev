# ═══════════════════════════════════════════════════════════════
# AdsFacile Frontend - Dockerfile DEV
# Vite dev server avec hot reload
# ═══════════════════════════════════════════════════════════════

FROM node:20-alpine
WORKDIR /app

# Installer les dépendances
COPY package*.json ./
RUN npm ci

# Copier le reste du code source
COPY . .

EXPOSE 5173

# Lancer le dev server Vite (--host pour être accessible depuis l'extérieur du conteneur)
CMD ["npx", "vite", "--host"]
