# Identifiants Google et Apple pour la pile Supabase locale (lus par supabase/config.toml).
# Copier en supabase/.env (jamais commité), remplir, puis `pnpm supabase stop && pnpm supabase start`.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
