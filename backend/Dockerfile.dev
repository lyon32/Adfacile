# ═══════════════════════════════════════════════════════════════
# AdsFacile Backend - Dockerfile DEV
# Node.js avec nodemon pour hot reload
# ═══════════════════════════════════════════════════════════════

FROM node:20-alpine
WORKDIR /app

# Installer toutes les dépendances (y compris devDependencies pour nodemon)
COPY package*.json ./
# npm install est plus robuste que npm ci face aux coupures réseau
RUN npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000 && \
    npm config set fetch-retries 5 && \
    npm install

# Copier le code source
COPY . .

ENV NODE_ENV=development
EXPOSE 5000

# Lancer avec nodemon pour le hot reload
CMD ["npm", "run", "dev"]
