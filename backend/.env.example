# ═══════════════════════════════════════════════════════════════════════════════
# Facebook Business OAuth
# 1. Créer une app Business sur https://developers.facebook.com
# 2. Ajouter les use cases : Marketing API + Meta Ads Manager
# 3. Configurer OAuth Redirect URI
# ═══════════════════════════════════════════════════════════════════════════════
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ATTENTION — cette URI doit être déclarée À L'IDENTIQUE, au caractère près, dans
# la console Meta : Facebook Login → Paramètres → « URI de redirection OAuth valides ».
# Sinon Meta répond « Impossible de charger cette URL ».
# Meta exige HTTPS : en développement, exposez le backend via un tunnel
#   npx cloudflared tunnel --url http://localhost:5000
# puis reportez ici l'URL du tunnel suivie de /api/facebook/callback.
FACEBOOK_REDIRECT_URI=https://votre-tunnel.trycloudflare.com/api/facebook/callback

# Version de la Graph API. Meta retire une version ~2 ans après sa sortie.
# v25.0 est valable jusqu'au 29 juillet 2028. (v19.0, utilisée auparavant,
# a expiré le 21 mai 2026 : tous les appels Graph échouaient.)
# Vérifier avant de monter : https://developers.facebook.com/docs/graph-api/changelog
# Laisser vide pour utiliser la valeur par défaut de src/config/facebook.js
FACEBOOK_GRAPH_VERSION=v25.0


# Taux de conversion des budgets
# L'utilisateur saisit des FCFA ; le compte publicitaire Meta est en USD.
# Combien de FCFA pour 1 USD. Valeur par défaut si absent : 610.
XAF_PER_USD=610
