# ═══════════════════════════════════════════════════════════════════════════════
# ADSFACILE BACKEND - VARIABLES D'ENVIRONNEMENT
# Copiez ce fichier vers .env et remplissez les valeurs
# ═══════════════════════════════════════════════════════════════════════════════

# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration
# Trouvez ces valeurs dans Settings > API de votre projet Supabase
SUPABASE_URL=https://aenkjumaetkfpobqxgvg.supabase.co
SUPABASE_ANON_KEY=votre_cle_anon_supabase
SUPABASE_SERVICE_KEY=votre_cle_service_role_supabase

# JWT Configuration
# Générez un secret fort avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_placeholder_change_me_in_prod
JWT_EXPIRE=24h

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# ═══════════════════════════════════════════════════════════════════════════════
# IA — Gemini (Plan Gratuit + tous les plans actuellement)
# Obtenez votre clé sur : https://aistudio.google.com/apikey
# Gratuit jusqu'à 1500 requêtes/jour
# ═══════════════════════════════════════════════════════════════════════════════
GEMINI_API_KEY=votre_cle_gemini
GEMINI_MODEL=gemini-1.5-flash

# ═══════════════════════════════════════════════════════════════════════════════
# IA — Claude Haiku (FUTUR — Plan PRO/Agency)
# Meilleure qualité en français, ~292 FCFA / 1000 appels
# Configurez USE_CLAUDE_FOR_PRO=true pour activer
# ═══════════════════════════════════════════════════════════════════════════════
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# USE_CLAUDE_FOR_PRO=false

# ═══════════════════════════════════════════════════════════════════════════════
# Facebook Business OAuth
# 1. Créer une app Business sur https://developers.facebook.com
# 2. Ajouter les use cases : Marketing API + Meta Ads Manager
# 3. Configurer OAuth Redirect URI
# ═══════════════════════════════════════════════════════════════════════════════
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ATTENTION — cette URI doit être déclarée À L'IDENTIQUE, au caractère près, dans
# la console Meta : Facebook Login → Paramètres → « URI de redirection OAuth valides ».
# Sinon Meta répond « Impossible de charger cette URL ».
# Meta exige HTTPS : en développement, exposez le backend via un tunnel
#   npx cloudflared tunnel --url http://localhost:5000
# puis reportez ici l'URL du tunnel suivie de /api/facebook/callback.
FACEBOOK_REDIRECT_URI=https://votre-tunnel.trycloudflare.com/api/facebook/callback
# Facebook Login for Business : ID de la configuration (tableau de bord Meta →
# Facebook Login for Business → Configurations). Remplace la liste scope.
FACEBOOK_LOGIN_CONFIG_ID=

# Version de la Graph API. Meta retire une version ~2 ans après sa sortie.
# v26.0 est la plus récente au 8 oct. 2026. (v19.0, utilisée auparavant,
# a expiré le 21 mai 2026 : tous les appels Graph échouaient.)
# Vérifier avant de monter : https://developers.facebook.com/docs/graph-api/changelog
# Laisser vide pour utiliser la valeur par défaut de src/config/facebook.js
FACEBOOK_GRAPH_VERSION=v26.0


# Taux de conversion des budgets
# L'utilisateur saisit des FCFA ; le compte publicitaire Meta est en USD.
# Combien de FCFA pour 1 USD. Valeur par défaut si absent : 610.
XAF_PER_USD=610

# ── Paiement SasPay (remplace CamPay) ──
# app.saspay.me → Développeur : clé secrète (scope PAYIN). sk_test_ = simulé.
SASPAY_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Webhooks → créer un webhook vers https://<backend>/api/billing/webhook
# (transaction.success, transaction.failed, transaction.cancelled).
# Le secret de signature n'est affiché qu'une fois : le copier ici.
SASPAY_WEBHOOK_SECRET=
