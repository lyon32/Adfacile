{
  "name": "pubeka",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:db": "turbo run test:db",
    "test:int": "turbo run test:int",
    "test:routes-coverage": "turbo run test:routes-coverage",
    "test:smoke-providers": "turbo run test:smoke-providers",
    "openapi:lint": "turbo run openapi:lint",
    "i18n:check": "turbo run i18n:check",
    "e2e:ci": "turbo run e2e:ci",
    "e2e:full": "turbo run e2e:full",
    "e2e:smoke": "turbo run e2e:smoke",
    "e2e:smoke:prod": "turbo run e2e:smoke:prod",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage:summary": "node scripts/noop.mjs",
    "ci:env": "node scripts/noop.mjs",
    "supabase": "supabase"
  },
  "devDependencies": {
    "@pubeka/config": "workspace:*",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.118.0",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "vercel": "60.1.1"
  }
}
