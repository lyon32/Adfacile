# Variables de apps/web (ENV_SETUP §1). Copier en .env.local ; liste complète en S02.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:5173
NEXT_PUBLIC_APP_URL=http://app.localhost:5173
# Domaines servis comme site public ; tout autre domaine est servi comme application.
SITE_HOSTS=localhost:5173
# Préfixe secret de l'administration (à générer, ENV_SETUP §1.3).
ADMIN_PATH=
