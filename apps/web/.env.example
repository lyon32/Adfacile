# Variables de apps/web (ENV_SETUP §1). Copier en .env.local ; liste complète en S02.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:5173
NEXT_PUBLIC_APP_URL=http://app.localhost:5173
# Domaines servis comme site public ; tout autre domaine est servi comme application.
SITE_HOSTS=localhost:5173
# Préfixe secret de l'administration (à générer, ENV_SETUP §1.3).
ADMIN_PATH=
# S04 — connexion. Valeurs locales : `pnpm supabase status` (ENV_SETUP §1.2).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# CAPTCHA Turnstile (D-1). En local : clé de site de TEST officielle de Cloudflare, invisible,
# « passe toujours » (developers.cloudflare.com/turnstile/troubleshooting/testing).
NEXT_PUBLIC_CAPTCHA_SITE_KEY=1x00000000000000000000BB
# Obligatoires pour env.ts (ENV_SETUP §1.1-1.3), à générer en local.
APP_SIGNING_SECRET=
TOKEN_ENCRYPTION_KEYS=
TOKEN_ENCRYPTION_ACTIVE_KEY_ID=
PUBEKA_JOB_DISPATCH=inline
